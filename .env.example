# Copy to .env and adjust as needed. Every value here can also be set
# directly in the environment or in config/config.yaml (see
# config/config.example.yaml). Env vars take precedence over the YAML file.

# mock | real (real is not implemented yet, see internal/device/linux.go)
INGEST_MODE=mock

# Current project/event name; used in the destination path
# <destination_root>/<project>/<camera>/<card>.
INGEST_PROJECT_NAME=TEST_EVENT

# Host port docker compose publishes (container always listens on 8080).
# Defaults to 8088 because 8080 is commonly already taken by other local
# services; set to 8080 freely if it's free on your machine.
INGEST_HOST_PORT=8088
